{
  "name": "@casefiles/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "postbuild": "npm run test && node ../../scripts/smoke.mjs && node ../../scripts/conditional-live-check.mjs",
    "test:live": "node ../../scripts/live-interview-check.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "vitest": "^3.0.8",
    "typescript": "^5.8.3"
  }
}
