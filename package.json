{
  "name": "casefiles",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "test": "npm run test -w apps/api",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:validate": "node scripts/i18n-validate.mjs",
    "i18n:strict": "node scripts/i18n-validate.mjs --strict",
    "i18n:api": "node scripts/i18n-api-coverage.mjs",
    "i18n:api:strict": "node scripts/i18n-api-coverage.mjs --strict"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.8.3"
  }
}
